\begin_layout Standard
\begin_inset Formula 
\begin{equation}
G=\frac{1}{1+\frac{R_{\text{out}}}{R_{\text{load}}}}\frac{1}{1+\frac{R_{\text{in}}}{R_{\text{s}}}}R_{\text{m}}\label{eq:guadagno-amplificatore-transresistenza}
