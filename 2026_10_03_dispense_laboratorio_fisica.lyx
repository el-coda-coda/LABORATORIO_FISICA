\begin_layout Standard
\begin_inset Formula 
\begin{equation}
G=\frac{1}{1+\frac{R_{\text{load}}}{R_{\text{out}}}}\frac{1}{1+\frac{R_{\text{in}}}{R_{\text{s}}}}A_{\text{sc}}\label{eq:guadagno-amplificatore-corrente}
\end{equation}

\end_inset


\end_layout

