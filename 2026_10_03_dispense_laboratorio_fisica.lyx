\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{out}}=V_{\text{load}}=\frac{1}{1+\frac{R_{\text{out}}}{R_{\text{load}}}}A_{\text{oc}}V_{\text{in}}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
V_{\text{out}}=\frac{1}{1+\frac{R_{\text{out}}}{R_{\text{load}}}}A_{\text{oc}}\frac{1}{1+\frac{R_{\text{s}}}{R_{\text{in}}}}V_{\text{s}}\label{eq:v-out-amplificatore-tensione}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Da cui si ottiene che il guadagno 
\begin_inset Formula $G=V_{\text{out}}/V_{\text{in}}$
\end_inset

 risulta:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
G=\frac{1}{1+\frac{R_{\text{out}}}{R_{\text{load}}}}\frac{1}{1+\frac{R_{\text{s}}}{R_{\text{in}}}}A_{\text{oc}}\label{eq:guadagno-amplificatore-tensione}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Da notare 
\begin_inset Formula $G\leq A_{\text{oc}}$
\end_inset

,
 per cui 
\begin_inset Formula $G=A_{\text{oc}}$
\end_inset

 nel caso ideale con 
\begin_inset Formula $R_{\text{out}}\to0$
\end_inset

 e 
\begin_inset Formula $r_{\text{in}}\to\infty$
\end_inset

.
\end_layout

