\begin_layout Standard
Andando a risolvere l'equazione ai nodi sulla rete di feedback,
 dove vengono usate 3 resistenze:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
i_{2}+i_{3}=i_{4}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
-\frac{V_{x}}{R_{2}}-\frac{V_{x}}{R_{3}}=\frac{V_{x}-V_{\text{out}}}{R_{4}}
\]

\end_inset


\end_layout

\begin_layout Standard
Da cui si ottiene 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
G=\frac{R_{2}}{R_{1}}\left(1+\frac{R_{4}}{R_{2}}+\frac{R_{4}}{R_{3}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Nel caso in cui 
\begin_inset Formula $R_{2}=kR_{3}$
\end_inset

 significa che 
\begin_inset Formula $i_{3}=ki_{2}$
\end_inset

 
\begin_inset Formula $\implies i_{4}=\left(1+k\right)i_{1}$
\end_inset

.
 Questo circuito si può usare come amplificatore di corrente quando il carico è 
\series bold
floating
\series default
 (non collegato a massa).
\end_layout

\begin_layout Subsection
Operazionale sommatore pesato
\end_layout

\begin_layout Standard
Per il principio di sovrapposizione vale 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{out}}=-\sum\frac{V_{i}}{R_{i}}R_{\text{f}}
\]

\end_inset


\end_layout

\begin_layout Subsection
Operazionale non invertente
\end_layout

\begin_layout Standard
Il segnale in tensione viene applicato all'ingresso non invertente 
\begin_inset Formula $\left(+\right)$
\end_inset

.
 In condizioni di idealità vale 
\begin_inset Formula $V_{\text{p}}=V_{\text{n}}=V_{\text{in}}$
\end_inset

 a causa del virtual short.
\end_layout

\begin_layout Standard
L'equazione ai nodi della maglia di feedback nel nodo del terminale invertente 
\begin_inset Formula $i_{1}=i_{2}$
\end_inset

 di ottiene
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{V_{\text{n}}}{R_{1}}=\frac{V_{\text{out}}-V_{\text{n}}}{R_{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
considerando le condizioni dovute al virtual short si ottiene:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
G=\left(1+\frac{R_{2}}{R_{1}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Si comporta come un partitore di tensione,
 dove il guadagno a circuito chiuso dipende esclusivamente dalla rete resistiva.
\end_layout

\begin_layout Standard
Questo tipo di circuito avrà che una frazione di 
\begin_inset Formula $V_{\text{out}}$
\end_inset

 viene fornita all'ingresso invertente controbilanciando l'aumento di 
\begin_inset Formula $V_{\text{d}}$
\end_inset

 e riportandolo vicino a zero:
 effetto di feedback degenerativo.
\end_layout

\begin_layout Standard
Nel caso di non idealità è sufficiente utilizzare 
\begin_inset Formula $V_{\text{n}}=V_{\text{in}}-\frac{V_{\text{out}}}{A}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
G=\frac{G_{\text{ideal}}}{1+\frac{G_{\text{ideal}}}{A}}
\]

\end_inset


\end_layout

\begin_layout Standard
Si ottiene che poi 
\begin_inset Formula $R_{\text{in}}\to\infty$
\end_inset

 e 
\begin_inset Formula $R_{\text{out}}\to0$
\end_inset

.
\end_layout

\begin_layout Subsubsection
Inseguitore di tensione o buffer
\end_layout

\begin_layout Standard
Si ottiene mettendo 
\begin_inset Formula $R_{2}=0$
\end_inset

 e si rimuove 
\begin_inset Formula $R_{1}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
G=1
\]

\end_inset


\end_layout

\begin_layout Standard
La resistenza del carico viene alimentata direttamente tramite le tensioni di alimentazione dell'operazionale.
\end_layout

\begin_layout Subsection
Amplificatore operazionale alle differenze
\end_layout

\begin_layout Standard
L'amplificatore alle differenze risponde alla differenza tra i segnali in ingresso e rigetta i segnali comuni (caso ideale).
\end_layout

\begin_layout Standard
Si definisce la tensione di modo comune
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{CM}}=\frac{V_{\text{p}}+V_{\text{n}}}{2}
\]

\end_inset


\end_layout

\begin_layout Standard
Da cui si ottengono le nuove relazioni:
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{cases}
V_{\text{p}}=V_{\text{CM}}+\frac{\text{V}_{\text{d}}}{2}\\
V_{\text{n}}=V_{\text{CM}}-\frac{\text{V}_{\text{d}}}{2}
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Standard
In generale vale 
\begin_inset Formula $V_{\text{out}}=A_{\text{d}}V_{\text{d}}+A_{\text{CM}}V_{\text{cm}}$
\end_inset

,
 con 
\begin_inset Formula $A_{\text{d}}$
\end_inset

 detto guadagno differenziale dell'amplificatore,
 mentre 
\begin_inset Formula $A_{\text{CM}}$
\end_inset

 è detto guadagno di modo comune dell'amplificatore.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\text{CMRR}=20\log\left(\frac{\left|A_{\text{d}}\right|}{\left|A_{\text{CM}}\right|}\right)
\]

\end_inset


\end_layout

\begin_layout Subsubsection
Caso con un solo amplificatore 
\end_layout

\begin_layout Standard
Tutte le tensioni sono riferite a massa.
 Per ricavare la funzione di trasferimento si utilizza il principio di sovrapposizione.
\end_layout

\begin_layout Standard
Al posto di 
\begin_inset Formula $V_{1}$
\end_inset

 si pone a massa e si lascia invariato 
\begin_inset Formula $V_{2}$
\end_inset

:
 al nodo 
\begin_inset Formula $V_{\text{n}}$
\end_inset

 si ottiene:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{V_{\text{out}}-V_{\text{n}}}{R_{2}}=\frac{V_{\text{n}}}{R_{1}}
\]

\end_inset


\end_layout

\begin_layout Standard
e al nodo 
\begin_inset Formula $V_{\text{p}}$
\end_inset

 si ottiene:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{V_{\text{p}}}{R_{4}}=\frac{V_{2}}{R_{3}+R_{4}}
\]

\end_inset


\end_layout

\begin_layout Standard
Andando a considerare il virtual short si ottiene che 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{out}}=\left(1+\frac{R_{2}}{R_{1}}\right)\frac{R_{4}}{R_{3}+R_{4}}V_{2}
\]

\end_inset


\end_layout

\begin_layout Standard
Al posto di 
\begin_inset Formula $V_{2}$
\end_inset

 si pone a massa e si lasci invariato 
\begin_inset Formula $V_{1}$
\end_inset

:
 si ottiene un amplificatore invertente con 
\begin_inset Formula $V_{\text{out}}=-\frac{R_{2}}{R_{1}}V_{1}$
\end_inset

.
\end_layout

\begin_layout Standard
Di conseguenza,
 andando a sommare i contributi si ottiene
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{out}}=\frac{R_{2}}{R_{1}}\left(\frac{1+\frac{R_{1}}{R_{2}}}{1+\frac{R_{3}}{R_{4}}}V_{2}-V_{1}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
nel caso particolare di 
\begin_inset Formula $R_{3}/R_{4}=R_{1}/R_{2}$
\end_inset

 si ha che 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{out}}=\frac{R_{2}}{R_{1}}\left(V_{2}-V_{1}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Ora si considera lo stesso circuito,
 ma con ai due capi di input la stessa tensione comune 
\begin_inset Formula $V_{\text{CM}}$
\end_inset

 analogamente a prima si ottiene che 
\begin_inset Formula $V_{\text{p}}=\frac{R_{4}}{R_{3}+R_{4}}V_{\text{CM}}$
\end_inset

 e 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{V_{\text{CM}}-V_{\text{n}}}{R_{1}}=\frac{V_{\text{n}}-V_{\text{out}}}{R_{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
da cui si ottiene andando a considerare il virtual short:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{out}}=\frac{R_{2}}{R_{1}}\left(\frac{1+\frac{R_{1}}{R_{2}}}{1+\frac{R_{3}}{R_{4}}}-1\right)V_{\text{CM}}
\]

\end_inset


\end_layout

\begin_layout Standard
Di conseguenza,
 lo stesso caso particolare precedente 
\begin_inset Formula $\left(R_{3}/R_{4}=R_{1}/R_{2}\right)$
\end_inset

 porta a avere 
\begin_inset Formula $V_{\text{out}}=0$
\end_inset

 e 
\begin_inset Formula $A_{\text{CM}}=0$
\end_inset

.
\end_layout

\begin_layout Standard
Un problema sta nel fatto che è impossibile avere resistenze identiche 
\begin_inset Formula $\implies$
\end_inset

 
\begin_inset Formula $\text{CMRR}\neq0$
\end_inset

.
\end_layout

\begin_layout Standard
Inoltre,
 se si va a valutare l'impedenza di ingresso e considerando il virtual short si osserva che 
\begin_inset Formula $V_{\text{d}}=2R_{1}$
\end_inset

 di conseguenza 
\begin_inset Formula $R_{\text{in}}=2R_{1}$
\end_inset

.
 Di conseguenza,
 se si vuole avere un certo guadagno 
\begin_inset Formula $A_{\text{d}}=R_{2}/R_{1}$
\end_inset

 si è vincolati o ad avere 
\begin_inset Formula $R_{2}$
\end_inset

 grande e imprecisa o 
\begin_inset Formula $R_{1}$
\end_inset

 e,
 di conseguenza,
 
\begin_inset Formula $R_{\text{in}}$
\end_inset

 piccole
\end_layout

\begin_layout Subsection
Amplificatore per strumentazione
\end_layout

\begin_layout Standard
Il problema della bassa impedenza dell'amplificatore differenziale si risolve introducendo 2 buffer in ingresso.
 Considerando 
\begin_inset Formula $A_{1}$
\end_inset

 e 
\begin_inset Formula $A_{2}$
\end_inset

 le amplificazioni a open-circuit,
 si ottiene 
\begin_inset Formula $V_{1,2\,x}=\left(1+\frac{R_{2}}{R_{1}}\right)V_{1,2}$
\end_inset

.
\end_layout

\begin_layout Standard
Di conseuenza,
 nel caso di idealità:
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{out}}=\frac{R_{4}}{R_{3}}\left(1+\frac{R_{2}}{R_{1}}\right)\left(V_{2}-V_{1}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
I vantaggi sono che la 
\series bold
resistenza di ingresso è infinita
\series default
 (idealmente) e rimane un 
\series bold
grande quadagno differenziale
\series default
.
 Se i due buffer e le resistenze collegate sono identiche il percorso seguito dai segnali è simmetrico.
\end_layout

\begin_layout Standard
Gli svantaggi sono che:
\end_layout

\begin_layout Enumerate
Il guadagno di ingresso è lo stesso per parte differenziale e di modo comune 
\begin_inset Formula $\implies$
\end_inset

 è facile arrivare a saturazione
\end_layout

\begin_layout Enumerate
Se i due buffer all'ingresso non sono identici,
 si ottiene in output un segnale spurio
\end_layout

\begin_layout Enumerate
Le resistenze 
\begin_inset Formula $R_{1}$
\end_inset

 e 
\begin_inset Formula $R_{2}$
\end_inset

 dovrebbero essere rispettivamente identiche tra i due buffer,
 cosa difficile da ottenere
\end_layout

\begin_layout Standard
Questi problemi si possono risolvere togliendo la massa tra le resistenze 
\begin_inset Formula $R_{1}$
\end_inset

.
 Considerando il virtual chort e il collegamento ottenuto si ha che
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
i=\frac{V_{1x}-V_{2x}}{2\left(R_{1}+R_{2}\right)}=\frac{V_{1}-V_{2}}{2R_{1}}
\]

\end_inset


\end_layout

\begin_layout Standard
Da cui si ottiene 
\begin_inset Formula $G=\frac{R_{4}}{R_{3}}\left(1+\frac{R_{2}}{R_{1}}\right)$
\end_inset

,
 importante notale che non è necessario che le due resistenze 
\begin_inset Formula $R_{2}$
\end_inset

 siano identiche:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
G=\frac{R_{4}}{R_{3}}\left(1+\frac{R_{2}+R'_{2}}{2R_{1}}\right)
\]

\end_inset


\end_layout

\begin_layout Subsubsection
Caso con ingressi collegati a tensione di modo comune
\end_layout

\begin_layout Standard
Si ottiene 
\begin_inset Formula $V_{1x}=V_{\text{CM}}=V_{2x}$
\end_inset

 da cui si ottiene che la caduta di potenziale tra 
\begin_inset Formula $2R_{1}$
\end_inset

 è nulla e la corrente che circola è nulla.
 Di conseguenza l'eventuale tensione di modo comune agli ingressi non viene amplificata dallo stadio iniziale e viene semplicemente propagata.
\end_layout

\begin_layout Subsection
Amplificatori operazionali di corrente
\end_layout

\begin_layout Standard
Si vanno a considerare amplificatori 
\series bold
grounded
\series default
.
\end_layout

\begin_layout Standard
La seguente configurazione è detta current-mirror:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
i_{\text{load}}=\frac{V_{\text{out}}-V_{\text{p}}}{R_{1}}=\frac{V_{n}-R_{2}i_{2}-V_{p}}{R_{1}}
\]

\end_inset


\end_layout

\begin_layout Standard
considerando il virtual short e 
\begin_inset Formula $i_{\text{in}}=i_{2}$
\end_inset

 si ottiene 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
i_{\text{load}}=-\frac{R_{2}}{R_{1}}i_{\text{in}}
\]

\end_inset


\end_layout

\begin_layout Standard
Un'altra configurazione si ottiene:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{out}}=V_{\text{n}}=V_{\text{p}}
\]

\end_inset


\end_layout

\begin_layout Standard
da cui si ottiene 
\begin_inset Formula $R_{1}i_{1}=R_{2}i_{2}$
\end_inset

,
 da cui 
\begin_inset Formula $i_{\text{load}}=i_{1}+i_{2}$
\end_inset

 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
i_{\text{load}}=\left(1+\frac{R_{2}}{R_{1}}\right)i_{\text{in}}
\]

\end_inset


\end_layout

\begin_layout Subsection
Amplificatori operazionali di transresistenza
\end_layout

\begin_layout Standard
In questa configurazione si ottiene 
\begin_inset Formula $V_{\text{out}}=-Ri_{\text{in}}$
\end_inset

.
 In condizioni di idealità 
\begin_inset Formula $R_{\text{in}}=0$
\end_inset

 e 
\begin_inset Formula $R_{\text{out}}=0$
\end_inset


\end_layout

\begin_layout Section
Circuiti
\end_layout

\begin_layout Subsection
Circuiti integratori
\end_layout

\begin_layout Standard
...
\end_layout

\begin_layout Subsubsection
Integratore reale o 
\begin_inset Quotes eld
\end_inset

lossy integrator
\begin_inset Quotes erd
\end_inset


\end_layout

\begin_layout Standard
A circuito aperto si ha:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{V_{\text{in}}-V_{x}}{R}=\frac{V_{x}-V_{\text{out}}}{1/\left(sC\right)}
\]

\end_inset

Per la definizione dell'operazionale 
\begin_inset Formula $V_{\text{out}}=aV_{d}=-aV_{x}$
\end_inset

.
\end_layout

\begin_layout Standard
Da cui si ottiene che 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{in}}=-\left(\frac{1}{a}+\frac{sRC}{a}+sRC\right)V_{\text{out}}
\]

\end_inset

Dunque 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{V_{\text{out}}}{V_{\text{in}}}=\frac{a}{1+\left(1+a\right)sRC}
\]

\end_inset


\end_layout

\begin_layout Standard
In corrente continua 
\begin_inset Formula $\left(s\to0\right)$
\end_inset

,
 il guadagno non è più infinito,
 e in generale si ha un polo spostato da 0:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
s_{p}=-\frac{1}{\left(a+1\right)RC}
\]

\end_inset


\end_layout

\begin_layout Subsection
Circuito differenziatore
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
H\left(s\right)=-\frac{Z_{R}}{Z_{C}}=-sRC
\]

\end_inset

Nel dominio del tempo:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
i_{c}=C\frac{dV_{\text{in}}}{dt}
\]

\end_inset


\end_layout

\begin_layout Standard
e andando a valutare l'equazione ai nodi:
 
\begin_inset Formula $i_{C}=i_{R}=-V_{\text{out}}/R$
\end_inset

 si ottiene
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{out}}=-RC\frac{dV_{\text{in}}}{dt}
\]

\end_inset

La funzione di trasferimento è 
\begin_inset Formula $H=-j\omega RC$
\end_inset

 
\begin_inset Formula $\implies\varphi=-\frac{\pi}{2}$
\end_inset

.
 
\end_layout

\begin_layout Standard
Si comporta sostanzialmente come un filtro passa alto con frequenza di taglio 
\begin_inset Formula $\omega_{0}=\infty$
\end_inset

.
\end_layout

\begin_layout Standard
Un problema è che anche il ruomre in questo modo viene amplificato,
 per risolvere questo problema di stabilità si inserisce una resistenza a monte del condensatore 
\begin_inset Formula $\left(R_{1}\right).$
\end_inset


\end_layout

\begin_layout Subsubsection
Differenziatore reale
\end_layout

\begin_layout Standard
Con circuito aperto si ha:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{V_{\text{in}}-V_{\text{x}}}{1/sC}=\frac{V_{x}-V_{\text{out}}}{R}
\]

\end_inset


\end_layout

\begin_layout Standard
andando a considerare la condizione 
\begin_inset Formula $V_{\text{out}}=aV_{d}=-aV_{x}$
\end_inset

 si ottiene
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{in}}=-\left(\frac{1}{a}+\frac{1}{asRC}+\frac{1}{sRC}\right)V_{\text{out}}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{V_{\text{out}}}{V_{\text{in}}}=\frac{sRC}{1+\frac{1}{a}+\frac{sRC}{a}}
\]

\end_inset


\end_layout

\begin_layout Standard
Il polo si trova in 
\begin_inset Formula 
\[
s_{p}=-\frac{a+1}{RC}
\]

\end_inset


\end_layout

\begin_layout Section
Filtri
\end_layout

\begin_layout Standard
Un filtro è un circuito che riceve un segnalre e restituisce un segnale che dipende dalla frequenza in ingresso.
 La risposta viene definita in ampiezza 
\begin_inset Formula $\left|H\left(j\omega\right)\right|$
\end_inset

 e in fase 
\begin_inset Formula $LH\left(j\omega\right)$
\end_inset

.
\end_layout

\begin_layout Standard
I filtri sono classificati come:
\end_layout

\begin_layout Enumerate
passa basso:
 
\begin_inset Formula $\omega<\omega_{c}\implies\left|H\right|=1$
\end_inset

,
 
\begin_inset Formula $\omega>\omega_{c}\implies\left|H\right|=0$
\end_inset

;
\end_layout

\begin_layout Enumerate
passa alto:
 
\begin_inset Formula $\omega>\omega_{c}\implies\left|H\right|=1$
\end_inset

,
 
\begin_inset Formula $\omega<\omega_{c}\implies\left|H\right|=0$
\end_inset

;
\end_layout

\begin_layout Enumerate
passa banda:
 
\begin_inset Formula $\omega\in\left[\omega_{L};\omega_{H}\right]\implies\left|H\right|=1$
\end_inset

,
 
\begin_inset Formula $\omega\notin\left[\omega_{L};\omega_{H}\right]\implies\left|H\right|=0$
\end_inset

;
\end_layout

\begin_layout Enumerate
taglia banda:
 
\begin_inset Formula $\omega\in\left[\omega_{L};\omega_{H}\right]\implies\left|H\right|=0$
\end_inset

,
 
\begin_inset Formula $\omega\notin\left[\omega_{L};\omega_{H}\right]\implies\left|H\right|=1$
\end_inset

;
\end_layout

\begin_layout Standard
I filtri passivi hanno solo resistenze,
 capacità,
 induttanze;
 i filtri attivi hanno operazionali.
\end_layout

\begin_layout Standard
Il comportamento del filtro è determinato dalla funzione di trasferimento:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
H\left(s\right)=\frac{X_{\text{out}}\left(s\right)}{X_{\text{in}}\left(s\right)}
\]

\end_inset

Dove 
\begin_inset Formula $X_{\text{in}}\left(s\right)=\mathscr{L}\left[X_{\text{in}}\left(t\right)\right]$
\end_inset

 (trasformata di Laplace),
 che corrisponde passare dal dominio del tempo a quello delle frequenze.
 Per ottenere 
\begin_inset Formula $X_{\text{out}}\left(t\right)=\mathscr{L}^{-1}\left[H\left(s\right)X_{\text{in}}\left(s\right)\right]$
\end_inset

.
\end_layout

\begin_layout Standard
Nel nostro caso,
 la funzione di trasferimento è un rapporto di polinomi a coefficienti reali,
 dove il grado del denominatore determina l'ordine del filtro 
\begin_inset Formula $\left(m\le n\right)$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
H\left(s\right)=\frac{a_{m}s^{m}+...+a_{1}s+a_{0}}{b_{n}s^{n}+...+b_{1}s+b_{0}}
\]

\end_inset

Conviene scriverla in funzione dei prodotti che evidenzino zeri e poli.
 Gli zeri e i poli possono essere reali e complessi,
 ma se sono complessi anche la soluzione coniugata è rispettivamente un zero o un polo.
\end_layout

\begin_layout Subsection
Stabilità dei circuiti
\end_layout

\begin_layout Definition
Un circuito si dice stabile se,
 in presenza di uno stimolo limitto,
 produce una risposta limitata.
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Standard
Per studiare la stabilità si inietta un impulso e si va a vedere la risposta naturale:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
h\left(t\right)=\mathscr{L}^{-1}\left[H\left(s\right)\mathscr{L}\left[\delta\left(t\right)\right]\right]
\]

\end_inset


\end_layout

\begin_layout Standard
dove 
\begin_inset Formula $\mathscr{L}\left[\delta\left(t\right)\right]=1$
\end_inset

.
\end_layout

\begin_layout Standard
Se 
\begin_inset Formula $H\left(s\right)$
\end_inset

 ha un polo reale con 
\begin_inset Formula $s=\sigma_{k}$
\end_inset

,
 
\begin_inset Formula $H\left(s\right)$
\end_inset

 contiene un termine:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{A_{k}}{a-\sigma_{k}}
\]

\end_inset


\end_layout

\begin_layout Standard
Di conseguenza 
\begin_inset Formula $h\left(t\right)=A_{k}e^{\sigma_{k}t}\cdot u\left(t\right)$
\end_inset

 dove 
\begin_inset Formula $u\left(t\right)$
\end_inset

 è la funzione di Heaviside.
\end_layout

\begin_layout Standard
Un circuito stabile deve avere tutti i poli nel semipiano 
\begin_inset Formula $\text{Re}\left(s\right)<0$
\end_inset

 con 
\begin_inset Formula $\sigma<0$
\end_inset

.
 Tutti i circuiti passivi sono stabili.
 
\end_layout

\begin_layout Subsection
Filtri del I ordine
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
H\left(s\right)=\frac{a_{1}s+a_{0}}{s+\omega_{0}}
\]

\end_inset

Il polo corrisponde a 
\begin_inset Formula $p=-\omega_{0}$
\end_inset

 e 
\begin_inset Formula $z_{1}=-a_{0}/a_{1}$
\end_inset

 permette di caratterizzare il tipo di filtro:
 
\end_layout

\begin_layout Enumerate
\begin_inset Formula $a_{1}=0$
\end_inset

:
 passa basso
\end_layout

\begin_layout Enumerate
\begin_inset Formula $a_{0}=0$
\end_inset

:
 passa alto
\end_layout

\begin_layout Example
Filtro RC passa basso (filtro passivo)
\end_layout

\begin_layout Example
\begin_inset Formula 
\[
H\left(s\right)=\frac{1}{1+sRC}
\]

\end_inset


\end_layout

\begin_layout Example
con 
\begin_inset Formula $\omega_{0}=\frac{1}{RC}$
\end_inset

 si ottiene 
\end_layout

\begin_layout Example
\begin_inset Formula 
\[
H\left(s\right)=\frac{\omega_{0}}{s+\omega_{0}}
\]

\end_inset


\end_layout

\begin_layout Example
Si studia la risposta a una funzione di Heaviside:
 
\begin_inset Formula $V_{\text{in}}\left(t\right)=V_{1}u\left(t\right)$
\end_inset

,
 considerando che 
\begin_inset Formula $\mathscr{L}\left[u\left(t\right)\right]=\frac{1}{s}$
\end_inset

 si ottiene 
\end_layout

\begin_layout Example
\begin_inset Formula 
\[
V_{\text{out}}\left(s\right)=\frac{\omega_{0}}{s+\omega_{0}}\frac{V_{1}}{s}=V_{1}\left(\frac{1}{s}-\frac{1}{s+\omega_{0}}\right)
\]

\end_inset


\end_layout

\begin_layout Example
\begin_inset Formula 
\[
V_{\text{out}}\left(t\right)=V_{1}u\left(t\right)-V_{1}e^{-\omega_{0}t}u\left(t\right)=V_{1}u\left(t\right)\left(1-e^{-\omega_{0}t}\right)
\]

\end_inset


\end_layout

\begin_layout Example
Si studi la risposta a un impulso quadrato:
 
\begin_inset Formula $V_{\text{in}}\left(t\right)=V_{1}\left(u\left(t\right)-u\left(t-t_{a}\right)\right)$
\end_inset


\end_layout

\begin_layout Example
\begin_inset Formula 
\[
\mathscr{L}\left[u\left(t-t_{a}\right)\right]=\frac{1}{s}e^{-t_{a}s}
\]

\end_inset


\end_layout

\begin_layout Example
\begin_inset Formula 
\[
V_{\text{out}}\left(s\right)=\frac{\omega_{0}}{s+\omega_{0}}\frac{V_{1}}{s}\left(1-e^{-t_{a}s}\right)
\]

\end_inset


\end_layout

\begin_layout Example
Tornando nel dominio del tempo si ottiene:
\end_layout

\begin_layout Example
\begin_inset Formula 
\[
V_{\text{out}}\left(t\right)=V_{1}u\left(t\right)\left(1-e^{-\omega_{0}t}\right)-V_{1}u\left(t-t_{a}\right)\left(1-e^{-\omega_{0}\left(t-t_{a}\right)}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Example
Filtro RC passa alto (filtro passivo)
\end_layout

\begin_layout Example
\begin_inset Formula 
\[
H\left(s\right)=\frac{sCR}{1+sCR}
\]

\end_inset


\end_layout

\begin_layout Example
\begin_inset Formula 
\[
H\left(s\right)=\frac{s}{s+\omega_{0}}
\]

\end_inset


\end_layout

\begin_layout Example
Caso di una funzione di Heaviside in ingresso:
\end_layout

\begin_layout Example
\begin_inset Formula 
\[
V_{\text{out}}\left(s\right)=\frac{V_{1}}{s+\omega_{0}}
\]

\end_inset


\end_layout

\begin_layout Example
\begin_inset Formula 
\[
V_{\text{out}}\left(t\right)=V_{1}e^{-\omega_{0}t}u\left(t\right)
\]

\end_inset


\end_layout

\begin_layout Example
Caso di un impulso quadrato in ingresso:
\end_layout

\begin_layout Example
\begin_inset Formula 
\[
V_{\text{out}}\left(s\right)=\frac{s}{s+\omega_{0}}\left(\frac{V_{1}}{s}-\frac{V_{1}}{s}e^{-t_{a}s}\right)
\]

\end_inset


\end_layout

\begin_layout Example
\begin_inset Formula 
\[
V_{\text{out}}\left(t\right)=V_{1}\left(e^{-\omega_{0}t}u\left(t\right)-V_{1}e^{-\omega_{0}\left(t-t_{a}\right)}u\left(t-t_{a}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Subsubsection
Filtro attivo del I ordine passa basso
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
H\left(s\right)=-\frac{\omega_{0}}{s}
\]

\end_inset


\end_layout

\begin_layout Standard
con 
\begin_inset Formula $\omega_{0}=1/\left(RC\right)$
\end_inset


\end_layout

\begin_layout Example
Si studia il caso di una funzione di Heaviside in ingresso:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{out}}\left(s\right)=H\left(s\right)V_{\text{in}}\left(s\right)=-\frac{\omega_{0}}{s^{2}}V_{\text{in}}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{out}}\left(t\right)=-\omega_{0}tV_{1}u\left(t\right)
\]

\end_inset


\end_layout

\begin_layout Example
Si studia il caso di un impulso quadrato in ingresso:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{in}}\left(s\right)=\frac{V_{1}}{s}\left(1-e^{-t_{a}s}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{out}}\left(t\right)=-\omega_{0}V_{1}\left(tu\left(t\right)+\left(t-t_{a}\right)u\left(t-t_{a}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Ora si considera un filtro attivo contenente anche la resistenza 
\begin_inset Formula $R_{2}$
\end_inset

:
 la funzione di trasferimento è la stessa a meno di un fattore moltiplicativo 
\begin_inset Formula $-R_{2}/R_{1}$
\end_inset


\end_layout

\begin_layout Subsubsection
Filtro attivo del I ordine passa alto
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
H\left(s\right)=-\frac{R_{2}}{\frac{1}{sC}}=-\frac{s}{\omega_{0}}
\]

\end_inset


\end_layout

\begin_layout Example
Si studia il caso di una funzione di Heaviside in ingresso:
\end_layout

\begin_layout Example
\begin_inset Formula 
\[
V_{\text{out}}\left(s\right)=-\frac{V_{1}}{\omega_{0}}
\]

\end_inset


\end_layout

\begin_layout Example
\begin_inset Formula 
\[
V_{\text{out}}\left(t\right)=-\frac{V_{1}}{\omega_{0}}\delta\left(t\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Example
Si studia il caso di un impulso quadrato in ingresso:
\end_layout

\begin_layout Example
\begin_inset Formula 
\[
V_{\text{out}}\left(s\right)=-\frac{V_{1}}{\omega_{0}}\left(1-e^{-t_{a}s}\right)
\]

\end_inset


\end_layout

\begin_layout Example
\begin_inset Formula 
\[
V_{\text{out}}\left(s\right)=-\frac{V_{1}}{\omega_{0}}\left(\delta\left(t\right)-\delta\left(t-t_{a}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Standard
In realtà il filtro ha come funzione di trasferimento 
\begin_inset Formula $H\left(s\right)=-\frac{R_{2}}{R_{1}}\frac{s}{s+\omega_{0}}$
\end_inset

.
\end_layout

\begin_layout Standard
Di conseguenza con una funzione di Heaviside si ha 
\begin_inset Formula 
\[
V_{\text{out}}\left(t\right)=-\frac{R_{2}}{R_{1}}V_{1}e^{-\omega_{0}t}u\left(t\right)
\]

\end_inset


\end_layout

\begin_layout Standard
mentre nel caso di un impulso quadrato:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{out}}\left(t\right)=-\frac{R_{2}}{R_{1}}V_{1}\left(e^{-\omega_{0}t}u\left(t\right)-e^{-\omega_{0}\left(t-t_{a}\right)}u\left(t-t_{a}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Subsubsection
Filtro attivo del primo ordine all-pass filter
\end_layout

\begin_layout Standard
La caratteristica di questo filtro è che:
\end_layout

\begin_layout Enumerate
zero e polo sono simmetrici rispetto all'origine
\end_layout

\begin_layout Enumerate
la risposta in frequenza ideale è costante a tutte le frequrenze
\end_layout

\begin_layout Enumerate
applica una selezione nella fase
\end_layout

\begin_layout Standard
Al nodo 
\begin_inset Formula $V_{p}$
\end_inset

 si ha
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{V_{\text{in}}-V_{p}}{R}=\frac{V_{p}}{1/\left(sC\right)}
\]

\end_inset


\end_layout

\begin_layout Standard
Al nodo 
\begin_inset Formula $V_{n}$
\end_inset

 si ha
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{V_{\text{in}}-V_{n}}{R_{1}}=\frac{V_{n}-V_{\text{out}}}{R_{1}}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{\text{out}}\left(s\right)=\frac{1-sRC}{1+sRC}V_{\text{in}}\left(s\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
H\left(s\right)=-\frac{s-\omega_{0}}{s+\omega_{0}}
\]

\end_inset


\end_layout

\begin_layout Subsection
Filtri del II ordine
\end_layout

\begin_layout Subsubsection
Filtro del II ordine passa banda
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
Z_{1}=Z_{R_{1}}+Z_{C_{1}}=R_{1}+\frac{1}{sC_{1}}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
Z_{2}=Z_{R_{2}}\parallel Z_{C_{2}}=\frac{R_{2}}{1+sR_{2}C_{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
H\left(s\right)=-\frac{Z_{2}}{Z_{1}}=-\frac{1}{R_{1}C_{1}}\frac{s}{\left(s+\omega_{1}\right)\left(s+\omega_{2}\right)}
\]

\end_inset


\end_layout

